# Copy this file to .env and replace provider keys with your own values.
# .env is ignored by Git and must never be committed.

# Neo4j local demo
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
NEO4J_AUTH=neo4j/replace-with-local-password

# Spring AI configuration (the sample application currently uses DeepSeek's compatible API).
SPRING_AI_OPENAI_API_KEY=replace-with-provider-key
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_MODEL=deepseek-chat

# Direct MyController demo configuration.
DEMO_AI_API_KEY=replace-with-provider-key
DEMO_AI_BASE_URL=https://api.deepseek.com
DEMO_AI_MODEL=deepseek-chat
